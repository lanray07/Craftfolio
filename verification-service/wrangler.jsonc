{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "craftfolio-rvs-unconfigured",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "env": {
    "sandbox": {
      "name": "craftfolio-rvs-sandbox",
      "vars": {"RVS_SANDBOX":"true", "ALLOW_AMAZON_TEST_RECEIPTS":"false"},
      "ratelimits": [{"name":"VERIFY_LIMIT","namespace_id":"3693158351","simple":{"limit":120,"period":60}}]
    },
    "staging": {
      "name": "craftfolio-rvs-staging",
      "vars": {"RVS_SANDBOX":"false", "ALLOW_AMAZON_TEST_RECEIPTS":"true"},
      "ratelimits": [{"name":"VERIFY_LIMIT","namespace_id":"3693158352","simple":{"limit":120,"period":60}}]
    },
    "production": {
      "name": "craftfolio-rvs-production",
      "vars": {"RVS_SANDBOX":"false", "ALLOW_AMAZON_TEST_RECEIPTS":"false"},
      "ratelimits": [{"name":"VERIFY_LIMIT","namespace_id":"3693158353","simple":{"limit":120,"period":60}}]
    }
  }
}
